/dts-v1/;
/plugin/;

/*
 * Robot HAT E1 (https://code.caric.io/Robotics/elec_RPI_Robot_HAT) on Orange Pi Zero 3W
 * (Allwinner A733), the head board of a DuckBuddy.
 *
 * Header wiring of the Robot HAT E1:
 *   TWI0:  PB3 SDA pin 3, PB2 SCL pin 5   codec 0x18, INA226 0x45, LSM6DSV16X 0x6A, Qwiic J5
 *                                          (the body IMU, a BNO055 at 0x28, goes here)
 *   TWI2:  PE2 SDA pin 19, PE1 SCL pin 23 Qwiic J8 (the head ToF goes here)
 *   I2S0:  PB5 BCLK pin 12, PB6 LRCK pin 35, PB7 DOUT pin 40, PB8 DIN pin 38
 *   UART0: PB9 TX pin 8, PB10 RX pin 10   servo bus (TX sets the bus direction on the HAT)
 *
 * Board notes:
 *   - The codec has its own 12 MHz oscillator (Y1). PB4 (pin 7) goes to the
 *     HAT's Qwiic J6, so it is not muxed as I2S0 MCLK. The machine driver
 *     still tells the codec its MCLK: mclk-fs = 1 with mclk-fp = 12 MHz for
 *     both rate families, so the codec PLL is set from 12 MHz.
 *   - The codec reset is an RC on the HAT (R6/C38): no reset-gpios.
 *   - The PAM8406 amp is always on (MUTE and SHDN tied high): no amp GPIO.
 *   - UART0 is the board's debug console. Its pin groups are empty in the
 *     base DTB (U-Boot muxes the console), so this overlay gives Linux the
 *     pins. The installer moves the console off ttyS0.
 */

/ {
	compatible = "xunlong,orangepi-4-pro", "arm,sun60iw2p1";

	fragment@0 {
		target-path = "/";

		__overlay__ {
			microduck_codec_3v3: microduck-codec-3v3 {
				compatible = "regulator-fixed";
				regulator-name = "microduck-codec-3v3";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			microduck_codec_1v8: microduck-codec-1v8 {
				compatible = "regulator-fixed";
				regulator-name = "microduck-codec-1v8";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};
		};
	};

	fragment@1 {
		target = <&twi0>;

		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			twi_drv_used = <1>;
			/* 400 kHz: the BNO055's maximum, and robotd reads it 200 times a second. */
			clock-frequency = <400000>;

			aic3104: codec@18 {
				compatible = "ti,tlv320aic3104";
				reg = <0x18>;
				#sound-dai-cells = <0>;
				/*
				 * MICBIAS stays off: the MEMS mic (MK1) runs from 3V3 and
				 * the electret inputs J2/J9 are biased on the HAT (R42,
				 * R22, R23).
				 */
				IOVDD-supply = <&microduck_codec_3v3>;
				DVDD-supply = <&microduck_codec_1v8>;
				AVDD-supply = <&microduck_codec_3v3>;
				DRVDD-supply = <&microduck_codec_3v3>;
				status = "okay";
			};
		};
	};

	/* Qwiic J8: the head ToF (/dev/i2c-2). */
	fragment@2 {
		target = <&twi2>;

		__overlay__ {
			status = "okay";
			twi_drv_used = <1>;
		};
	};

	fragment@3 {
		target = <&i2s0_plat>;

		__overlay__ {
			/*
			 * No i2s0_pins_a (PB4 MCLK). "sleep" is the same set: the
			 * sunxi driver selects "sleep" when either stream closes,
			 * even while the other still runs, and the stock sleep state
			 * stops BCLK/LRCK to the codec and takes PB4.
			 */
			pinctrl-0 = <&i2s0_pins_b &i2s0_pins_c &i2s0_pins_d &i2s0_pins_e>;
			pinctrl-1 = <&i2s0_pins_b &i2s0_pins_c &i2s0_pins_d &i2s0_pins_e>;
			status = "okay";
		};
	};

	fragment@4 {
		target = <&i2s0_mach>;

		__overlay__ {
			status = "okay";
			soundcard-mach,name = "aic3104";
			soundcard-mach,format = "i2s";
			soundcard-mach,slot-num = <2>;
			soundcard-mach,slot-width = <32>;
			soundcard-mach,jack-support = <0>;
			soundcard-mach,frame-master = <&i2s0_cpu>;
			soundcard-mach,bitclock-master = <&i2s0_cpu>;
			soundcard-mach,widgets =
				"Speaker", "Speaker",
				"Microphone", "Onboard Mic",
				"Microphone", "Mic J2",
				"Microphone", "Mic J9";
			/* J1 (the speaker) is on the amp's right channel. */
			soundcard-mach,routing =
				"Speaker", "LLOUT",
				"Speaker", "RLOUT",
				"MIC2R", "Onboard Mic",
				"LINE1L", "Mic J2",
				"LINE1R", "Mic J9";
		};
	};

	fragment@5 {
		target = <&i2s0_cpu>;

		__overlay__ {
			soundcard-mach,pll-fs = <1>;
			/* The codec's MCLK: the 12 MHz oscillator on the HAT. */
			soundcard-mach,mclk-fs = <1>;
			soundcard-mach,mclk-fp = <12000000 12000000>;
		};
	};

	fragment@6 {
		target = <&i2s0_codec>;

		__overlay__ {
			sound-dai = <&aic3104>;
		};
	};

	/*
	 * The servo bus at 500 kbit/s: 24 MHz / 16 / 3, exact on the stock UART
	 * clock.
	 */
	fragment@7 {
		target = <&uart0_pins_active>;

		__overlay__ {
			pins = "PB9", "PB10";
			function = "uart0";
		};
	};

	fragment@8 {
		target = <&uart0_pins_sleep>;

		__overlay__ {
			pins = "PB9", "PB10";
			function = "gpio_in";
		};
	};
};
