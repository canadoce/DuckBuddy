[Unit]
Description=visiond (brain): the duck's eyes - the head camera (duckcam), faces, QR Wi-Fi provisioning
After=lifed-dev.service

[Service]
ExecStart=/usr/bin/python3 %h/visiond/visiond.py
WorkingDirectory=%h/visiond
StandardOutput=append:%h/robot/recs/visiond-service.log
StandardError=append:%h/robot/recs/visiond-service.log
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
